# Repository upload trimming, primarily for the ARQ worker's repo-root archive.
#
# Railway 5.41.2 selects paths with ignore::WalkBuilder before applying
# --path-as-root to archive names. Parent .railwayignore rules therefore also
# affect API/frontend uploads launched from their own subdirectories. Keep every
# required build input for those services; path-as-root does not isolate ignore
# rules. In particular frontend/public (including the stamped release receipt)
# must remain included. The worker image never copies those public assets.
# Primary source: https://github.com/railwayapp/cli/blob/v5.41.2/src/controllers/upload.rs
#
# `railway up` already honors .gitignore, so node_modules/.venv/build output need no entry.

# The worker compiles the same nesting kernel as the browser. Keep its package
# lock, source and profile-verified build tools in the archive; omit unrelated output.
frontend/build/
frontend/dist/
frontend/e2e/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.browser-harness/
frontend/tools/browser-harness/
backend/nesting-runtime/
landing/
load-tests/
docs/
nginx/
supabase/
signature/
e2e/
.github/
.claude/
