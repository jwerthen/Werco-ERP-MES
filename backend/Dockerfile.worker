# ARQ background worker image.
#
# WHY A SEPARATE DOCKERFILE, and not `Dockerfile` + a start-command override:
#
#   The API image's CMD is `alembic upgrade head && uvicorn app.main:app ...`. A worker
#   service built from that image and deployed with its start command left at the default
#   would come up as a SECOND API REPLICA -- it would answer /health, pass its healthcheck,
#   look perfectly green in the Railway dashboard, and run exactly zero background jobs.
#   That is the single most likely way to "deploy a worker" and still have no worker.
#   Baking `arq` into CMD makes that failure impossible: forget every override and the
#   container is still a worker.
#
# WHY NO `alembic upgrade head` HERE:
#
#   Migrations are the API's job and only the API's job. Two services racing `alembic
#   upgrade head` on the same database at deploy time is a real way to corrupt the version
#   table. The worker starts against whatever schema the API has already migrated to.
#
# BUILD CONTEXT: the REPO ROOT, not backend/ -- see the root railway.toml for why the
# worker's config file cannot live in backend/. Hence the `backend/` prefixes below.

# Official Node 22 image, pinned to the multi-platform manifest. Keep the exact
# runtime synchronized with the required image smoke and deployment identity gate.
# https://github.com/nodejs/docker-node/tree/main/22/bookworm-slim
FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS nesting-build
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN HUSKY=0 npm ci --no-audit --no-fund
COPY frontend/tsconfig.json frontend/tsconfig.nesting-worker.json ./
COPY frontend/tools/build-nesting-worker.mjs frontend/tools/nesting-server-worker.ts ./tools/
COPY frontend/src/ ./src/
RUN npm run build:nesting-worker -- --out-dir=/nesting-runtime

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for PostgreSQL and PDF processing. The worker renders
# receiving labels and archives audit logs, so it needs the same toolchain as the API.
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    poppler-utils \
    tesseract-ocr \
    antiword \
    libstdc++6 \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root user for security
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Copy application code (bust cache with ARG)
ARG CACHEBUST=1
COPY --chown=appuser:appgroup backend/ .

# The API images remain Python-only. Only this worker receives the fixed Node
# executable and compiled shared kernel; npm, node_modules and frontend assets
# stay in the build stage. Never accept a caller-selected executable or path.
COPY --from=nesting-build /usr/local/bin/node /usr/local/bin/node
COPY --from=nesting-build /usr/local/LICENSE /usr/local/share/doc/node/LICENSE
COPY --from=nesting-build /nesting-runtime/ /app/nesting-runtime/
RUN node -e 'const fs=require("node:fs"),c=require("node:crypto"),m=JSON.parse(fs.readFileSync("/app/nesting-runtime/manifest.json"));if(process.version!=="v22.23.2"||m.protocol!==1||m.node_major!==22||m.bundle_sha256!==c.createHash("sha256").update(fs.readFileSync("/app/nesting-runtime/solver.cjs")).digest("hex"))process.exit(1)'

# Writable dirs for the non-root user. COPY --chown does not change /app itself
# (root-owned from WORKDIR), and documents.py makedirs /app/uploads at import time.
# NOTE: /app/uploads and /app/logs are EPHEMERAL on Railway unless a volume is attached.
# archive_aged_audit_logs_job writes its NDJSON export to AUDIT_ARCHIVE_DIR -- point that
# at object storage or a mounted volume before arming that cron, or the export vanishes
# with the container. See docs/WORKER_SERVICE.md.
RUN mkdir -p /app/uploads /app/logs && chown appuser:appgroup /app /app/uploads /app/logs

# Run as non-root user
USER appuser

# No EXPOSE and no HEALTHCHECK: this process serves no HTTP. It is not a bug that
# `curl /health` fails against it -- there is nothing listening, by design. Anything that
# tries to health-check this container over HTTP is misconfigured; see the root
# railway.toml, which deliberately declares no healthcheckPath.

# ARQ reads WorkerSettings, which fails fast at import if REDIS_URL / REDIS_HOST resolve to
# the localhost default in production or staging (app/core/queue.py::assert_redis_configured).
CMD ["arq", "app.worker.WorkerSettings"]
